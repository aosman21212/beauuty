<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record id="module_category_beauty_spa" model="ir.module.category">
        <field name="name">Beauty Spa</field>
        <field name="sequence">200</field>
    </record>

    <!-- Privilege (Odoo 19 replaces category_id on res.groups) -->
    <record id="privilege_spa_role" model="res.groups.privilege">
        <field name="name">Beauty Spa</field>
        <field name="category_id" ref="module_category_beauty_spa"/>
    </record>

    <!-- Receptionist must be defined before Manager (Manager implies Receptionist) -->
    <record id="group_spa_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="privilege_spa_role"/>
    </record>

    <record id="group_spa_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_spa_role"/>
        <field name="implied_ids" eval="[Command.link(ref('group_spa_receptionist'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
