<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_spa_room_list" model="ir.ui.view">
        <field name="name">spa.room.list</field>
        <field name="model">spa.room</field>
        <field name="arch" type="xml">
            <list string="Treatment Rooms" editable="bottom">
                <field name="name"/>
                <field name="capacity"/>
                <field name="description"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_spa_room_form" model="ir.ui.view">
        <field name="name">spa.room.form</field>
        <field name="model">spa.room</field>
        <field name="arch" type="xml">
            <form string="Treatment Room">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Room notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spa_room" model="ir.actions.act_window">
        <field name="name">Treatment Rooms</field>
        <field name="res_model">spa.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
