<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Calendar -->
    <record id="view_spa_appointment_calendar" model="ir.ui.view">
        <field name="name">spa.appointment.calendar</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="appointment_date"
                      date_stop="appointment_end"
                      color="color"
                      mode="week"
                      quick_create="0">
                <field name="client_id" filters="1"/>
                <field name="therapist_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_spa_appointment_kanban" model="ir.ui.view">
        <field name="name">spa.appointment.kanban</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="client_id"/>
                <field name="therapist_id"/>
                <field name="appointment_date"/>
                <field name="total_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="color"/>
                <progressbar field="state"
                    colors='{"draft":"200","confirmed":"info","in_progress":"warning","done":"success","cancelled":"danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold"><field name="name"/></div>
                            <div><field name="client_id"/></div>
                            <div class="text-muted small">
                                <i class="fa fa-user" title="Therapist"/> <field name="therapist_id"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-calendar" title="Date"/>
                                <field name="appointment_date" widget="datetime"/>
                            </div>
                            <div class="fw-bold text-primary">
                                <field name="total_price" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="view_spa_appointment_list" model="ir.ui.view">
        <field name="name">spa.appointment.list</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'in_progress'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="therapist_id"/>
                <field name="room_id"/>
                <field name="appointment_date"/>
                <field name="duration" string="Duration (min)"/>
                <field name="total_price" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_spa_appointment_form" model="ir.ui.view">
        <field name="name">spa.appointment.form</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Mark Done"
                            type="object" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_create_invoice" string="Create Invoice"
                            type="object" class="btn-primary"
                            invisible="state not in ('confirmed','in_progress','done') or invoice_id != False"/>
                    <button name="action_view_invoice" string="View Invoice"
                            type="object"
                            invisible="invoice_id == False"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_invoice"
                                icon="fa-file-text-o"
                                invisible="invoice_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                                <span class="o_stat_value">
                                    <field name="invoice_state"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Appointment Details">
                            <field name="client_id"/>
                            <field name="therapist_id"/>
                            <field name="room_id"/>
                            <field name="appointment_date"/>
                            <field name="duration"/>
                            <field name="appointment_end" readonly="1"/>
                        </group>
                        <group string="Pricing">
                            <field name="package_id"/>
                            <field name="total_price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="services">
                            <field name="service_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_spa_appointment_search" model="ir.ui.view">
        <field name="name">spa.appointment.search</field>
        <field name="model">spa.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name"/>
                <field name="client_id"/>
                <field name="therapist_id"/>
                <filter string="New" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state','=','confirmed')]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state','=','cancelled')]"/>
                <group>
                    <filter string="Therapist" name="by_therapist"
                            context="{'group_by': 'therapist_id'}"/>
                    <filter string="Status" name="by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="by_date"
                            context="{'group_by': 'appointment_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spa_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">spa.appointment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</odoo>
