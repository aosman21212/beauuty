<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_spa_therapist_list" model="ir.ui.view">
        <field name="name">spa.therapist.list</field>
        <field name="model">spa.therapist</field>
        <field name="arch" type="xml">
            <list string="Therapists">
                <field name="name"/>
                <field name="job_title" string="Specialisation"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="appointment_count" string="Appointments"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_spa_therapist_form" model="ir.ui.view">
        <field name="name">spa.therapist.form</field>
        <field name="model">spa.therapist</field>
        <field name="arch" type="xml">
            <form string="Therapist">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_appointments"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo"
                                   string="Appointments"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full name…"/></h1>
                        <h3><field name="job_title" placeholder="Specialisation…"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="service_ids" widget="many2many_tags"
                           string="Offered Services"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_spa_therapist_kanban" model="ir.ui.view">
        <field name="name">spa.therapist.kanban</field>
        <field name="model">spa.therapist</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="job_title"/>
                <field name="image"/>
                <field name="appointment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click text-center">
                            <img t-att-src="'/web/image/spa.therapist/' + record.id.raw_value + '/image/64x64'"
                                 class="rounded-circle mb-2"
                                 style="width:64px;height:64px;object-fit:cover;"
                                 alt="Photo"/>
                            <div><strong><field name="name"/></strong></div>
                            <div class="text-muted small"><field name="job_title"/></div>
                            <div class="text-info small">
                                <field name="appointment_count"/> appts
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spa_therapist" model="ir.actions.act_window">
        <field name="name">Therapists</field>
        <field name="res_model">spa.therapist</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
