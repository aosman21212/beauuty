<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_spa_service_category_list" model="ir.ui.view">
        <field name="name">spa.service.category.list</field>
        <field name="model">spa.service.category</field>
        <field name="arch" type="xml">
            <list string="Service Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="service_count" string="Services"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_spa_service_category_form" model="ir.ui.view">
        <field name="name">spa.service.category.form</field>
        <field name="model">spa.service.category</field>
        <field name="arch" type="xml">
            <form string="Service Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_services"
                                icon="fa-list">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Category description…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spa_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">spa.service.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
