    <menuitem id="menu_beauty_spa_config"
              name="Configuration"
              parent="menu_beauty_spa_root"
              sequence="99"
              groups="beauty_spa.group_spa_manager"/>

    <menuitem id="menu_spa_config_categories"
              name="Service Categories"
              parent="menu_beauty_spa_config"
              action="action_spa_service_category"
              sequence="10"/>

    <menuitem id="menu_spa_config_rooms"
              name="Treatment Rooms"
              parent="menu_beauty_spa_config"
              action="action_spa_room"
              sequence="20"/>
